# Copy to .env (or paste into the Portainer stack's environment variables).

# --- Cloudflare Access (required unless AUTH_MODE=dev)
# Zero Trust team domain, e.g. bearnet.cloudflareaccess.com  (Zero Trust > Settings > Custom Pages > Team domain)
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Application Audience (AUD) tag of the Access application for poker.bear-net.com (Access > Applications > your app > Overview)
CF_POLICY_AUD=paste-the-aud-tag-here
# Tunnel token (Networks > Tunnels > your tunnel > Install connector). Used by the cloudflared container only.
CF_TUNNEL_TOKEN=paste-the-tunnel-token-here

# --- App
# Comma-separated Gmail addresses that get the admin controls (table settings, start/end, bots, kick)
ADMIN_EMAILS=jchebert1@gmail.com
# cloudflare (default) or dev. dev = no auth, identity from a cookie; for LAN testing only. NEVER expose dev mode to the internet.
AUTH_MODE=cloudflare
PORT=3000
DATA_DIR=/data
