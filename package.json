{
  "name": "bear-net-poker",
  "version": "1.0.0",
  "description": "Self-hosted No-Limit Texas Hold'em for friends. Zero dependencies: Node built-ins only.",
  "private": true,
  "main": "server/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "AUTH_MODE=dev ADMIN_EMAILS=${ADMIN_EMAILS:-admin@example.com} node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node test/auth.test.js && node --disable-warning=ExperimentalWarning test/sim.js 6 60",
    "test:skill": "node --disable-warning=ExperimentalWarning test/skill.js",
    "test:e2e": "bash test/run-e2e.sh"
  },
  "license": "MIT"
}
